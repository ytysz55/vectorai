{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vectorai.local/e2-g1-report.schema.json",
  "title": "VectorAI E2 Gate G1 Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "case_count",
    "semantic_digest",
    "evaluation",
    "measurements"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "case_count": {"type": "integer", "minimum": 1},
    "semantic_digest": {"$ref": "#/$defs/sha256"},
    "evaluation": {"$ref": "#/$defs/evaluation"},
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/measurement"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_number": {
      "type": ["number", "null"]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "exact_topology_rate",
        "shared_boundary_invariant_rate",
        "hard_failure_count",
        "baseline_node_advantage",
        "baseline_comparison_count",
        "no_subpixel_rmse_delta",
        "bezier_only_node_delta",
        "criteria"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "exact_topology_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "shared_boundary_invariant_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hard_failure_count": {"type": "integer", "minimum": 0},
        "baseline_node_advantage": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/nullable_number"}
        },
        "baseline_comparison_count": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "no_subpixel_rmse_delta": {"$ref": "#/$defs/nullable_number"},
        "bezier_only_node_delta": {"$ref": "#/$defs/nullable_number"},
        "criteria": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "boolean"}
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "runner",
        "status",
        "exact_topology",
        "premultiplied_rgba_rmse",
        "node_count",
        "wall_time_ms",
        "message"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "runner": {"type": "string", "minLength": 1},
        "status": {"enum": ["success", "failed"]},
        "exact_topology": {"type": ["boolean", "null"]},
        "premultiplied_rgba_rmse": {"$ref": "#/$defs/nullable_number"},
        "node_count": {"type": ["integer", "null"], "minimum": 0},
        "wall_time_ms": {"$ref": "#/$defs/nullable_number"},
        "message": {"type": "string"}
      }
    }
  }
}

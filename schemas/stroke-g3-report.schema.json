{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vectorai.local/stroke-g3-report.schema.json",
  "title": "VectorAI Stroke Gate G3 Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_id", "semantic_digest", "confusion_matrix",
    "evaluation", "measurements"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "semantic_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "confusion_matrix": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "integer", "minimum": 0}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed", "routing_accuracy", "connectivity_accuracy", "junction_accuracy",
        "maximum_centerline_p95", "mean_width_error", "style_accuracy",
        "fidelity_band_rate", "node_advantage_vs_fill", "cut_outline_rate",
        "hard_failure_count", "criteria"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "routing_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "connectivity_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "junction_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_centerline_p95": {"type": ["number", "null"], "minimum": 0},
        "mean_width_error": {"type": ["number", "null"], "minimum": 0},
        "style_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "fidelity_band_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "node_advantage_vs_fill": {"type": ["number", "null"]},
        "cut_outline_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "hard_failure_count": {"type": "integer", "minimum": 0},
        "criteria": {"type": "object", "additionalProperties": {"type": "boolean"}}
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id", "status", "route_expected", "route_actual", "route_correct",
          "connectivity_exact", "junction_exact", "centerline_p95", "width_error",
          "width_model", "cap_exact", "join_exact", "stroke_rmse", "fill_rmse",
          "stroke_nodes", "fill_nodes", "selected_kind", "cut_outline_valid", "message"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["success", "failed"]},
          "route_expected": {"enum": ["fill", "stroke", "ambiguous"]},
          "route_actual": {"type": ["string", "null"]},
          "route_correct": {"type": "boolean"},
          "connectivity_exact": {"type": ["boolean", "null"]},
          "junction_exact": {"type": ["boolean", "null"]},
          "centerline_p95": {"type": ["number", "null"], "minimum": 0},
          "width_error": {"type": ["number", "null"], "minimum": 0},
          "width_model": {"type": ["string", "null"]},
          "cap_exact": {"type": ["boolean", "null"]},
          "join_exact": {"type": ["boolean", "null"]},
          "stroke_rmse": {"type": ["number", "null"], "minimum": 0},
          "fill_rmse": {"type": ["number", "null"], "minimum": 0},
          "stroke_nodes": {"type": ["integer", "null"], "minimum": 0},
          "fill_nodes": {"type": ["integer", "null"], "minimum": 0},
          "selected_kind": {"type": ["string", "null"]},
          "cut_outline_valid": {"type": ["boolean", "null"]},
          "message": {"type": "string"}
        }
      }
    }
  }
}

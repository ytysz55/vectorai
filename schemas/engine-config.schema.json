{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vectorai.local/engine-config.schema.json",
  "title": "VectorAI Engine Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "mode",
    "seed",
    "resource_limits",
    "determinism",
    "debug_artifact_policy",
    "requested_outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mode": {
      "enum": ["faithful", "geometric", "minimal", "cut_ready"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "resource_limits": {
      "$ref": "#/$defs/resource_limits"
    },
    "determinism": {
      "$ref": "#/$defs/determinism"
    },
    "debug_artifact_policy": {
      "enum": ["none", "failures", "all"]
    },
    "requested_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["svg", "preview", "manifest", "validation", "metrics", "debug"]
      }
    }
  },
  "$defs": {
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_pixels",
        "max_regions",
        "max_edges",
        "max_candidates",
        "max_wall_time_ms",
        "max_memory_mb"
      ],
      "properties": {
        "max_input_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "max_regions": {
          "type": "integer",
          "minimum": 1
        },
        "max_edges": {
          "type": "integer",
          "minimum": 1
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_time_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_memory_mb": {
          "type": "integer",
          "minimum": 64
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "thread_count", "platform_contract"],
      "properties": {
        "policy": {
          "const": "strict"
        },
        "thread_count": {
          "type": "integer",
          "minimum": 1
        },
        "platform_contract": {
          "enum": ["same_platform_bytes", "cross_platform_tolerance"]
        }
      }
    }
  }
}

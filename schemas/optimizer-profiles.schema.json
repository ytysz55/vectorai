{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vectorai.local/optimizer-profiles.schema.json",
  "title": "VectorAI Optimizer Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "normalization_version", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "normalization_version": {"const": "1.0.0"},
    "profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version",
        "mode",
        "weights",
        "limits",
        "render_and_rank"
      ],
      "properties": {
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mode": {"enum": ["faithful", "geometric", "minimal", "cut_ready"]},
        "weights": {"$ref": "#/$defs/weights"},
        "limits": {"$ref": "#/$defs/limits"},
        "render_and_rank": {"$ref": "#/$defs/render_and_rank"}
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fidelity", "boundary", "complexity", "regularization", "color"],
      "properties": {
        "fidelity": {"type": "number", "minimum": 0, "maximum": 1},
        "boundary": {"type": "number", "minimum": 0, "maximum": 1},
        "complexity": {"type": "number", "minimum": 0, "maximum": 1},
        "regularization": {"type": "number", "minimum": 0, "maximum": 1},
        "color": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_iterations",
        "max_evaluations",
        "top_k",
        "early_stop_patience",
        "minimum_improvement",
        "step_schedule",
        "max_vertex_delta_px",
        "max_primitive_delta_px",
        "max_color_delta",
        "max_width_delta_px",
        "minimum_positive_geometry"
      ],
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1},
        "max_evaluations": {"type": "integer", "minimum": 1},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 32},
        "early_stop_patience": {"type": "integer", "minimum": 1},
        "minimum_improvement": {"type": "number", "exclusiveMinimum": 0},
        "step_schedule": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "max_vertex_delta_px": {"type": "number", "minimum": 0},
        "max_primitive_delta_px": {"type": "number", "minimum": 0},
        "max_color_delta": {"type": "number", "minimum": 0, "maximum": 1},
        "max_width_delta_px": {"type": "number", "minimum": 0},
        "minimum_positive_geometry": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "render_and_rank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scales", "backgrounds", "fidelity_band"],
      "properties": {
        "scales": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": [0.5, 1, 2, 4]}
        },
        "fidelity_band": {"type": "number", "minimum": 0, "maximum": 1},
        "backgrounds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["transparent", "black", "white", "checkerboard"]}
        }
      }
    }
  }
}

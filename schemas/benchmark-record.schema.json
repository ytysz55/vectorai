{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vectorai.local/benchmark-record.schema.json",
  "title": "VectorAI Benchmark Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_family_id",
    "case_id",
    "split",
    "primary_class",
    "tags",
    "source",
    "variant",
    "runner",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "design_family_id": {
      "$ref": "#/$defs/id"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "split": {
      "enum": ["development", "validation", "locked_test"]
    },
    "primary_class": {
      "enum": ["logo", "icon", "turkish_text", "jpeg_blur", "alpha", "line_art"]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "variant": {
      "$ref": "#/$defs/variant"
    },
    "runner": {
      "$ref": "#/$defs/runner"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "provenance", "license_id"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ground_truth_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "seed", "width", "height", "parameters"],
      "properties": {
        "tier": {
          "enum": ["T0", "T1", "T2", "T3"]
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "preset", "status", "run_manifest_sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["success", "failed", "timeout", "unsupported"]
        },
        "run_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "value", "unit", "valid"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "valid": {
          "type": "boolean"
        },
        "higher_is_better": {
          "type": "boolean"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "media_type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
